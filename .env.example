# Backend Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex
DB_USER=apex_user
DB_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# ODIN Configuration
ODIN_URL=wss://odin.syncpoint.io
ODIN_API_KEY=your_odin_api_key

# Weather APIs
OPEN_METEO_API=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=your_openweathermap_api_key
MET_NORWAY_API=https://api.met.no/weatherapi

# Mapbox (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Cesium (Optional)
CESIUM_ION_TOKEN=your_cesium_ion_token

# Grafana (Analytics Dashboard)
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
GRAFANA_URL=http://localhost:3001

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_MAPBOX_TOKEN=your_mapbox_token
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token

# Tactical Communications (WebRTC voice + messaging)
# 32+ character key used for AES-256-GCM encryption of message content at rest.
# A random key is generated per process if unset, making stored messages
# unreadable after a restart.
COMMS_ENCRYPTION_KEY=change_me_to_a_32_character_minimum_secret
# Automatic key rotation interval in milliseconds (default 1 hour).
COMMS_KEY_ROTATION_MS=3600000
# Comms auth token lifetime, e.g. 12h.
COMMS_TOKEN_TTL=12h
# Message retention in days (0 = keep permanently).
COMMS_RETENTION_DAYS=30
# Maximum messages a station may send per minute.
COMMS_RATE_LIMIT=60
# Maximum voice log entries retained per channel.
COMMS_MAX_VOICE_LOGS=200
# Opus target bitrate (bits/sec) for tactical radio quality.
VOICE_BITRATE=24000

# WebRTC NAT traversal
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
