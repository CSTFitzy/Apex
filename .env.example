# Backend Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Comma-separated list of allowed browser origins for CORS (no wildcard).
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sharknet
DB_USER=sharknet_user
DB_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WebRTC voice calls (STUN/TURN)
# Comma-separated list of STUN server URLs advertised to clients.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated list of TURN server URLs (required for peers behind
# symmetric NATs). Leave empty to only offer STUN.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# ODIN Configuration
ODIN_URL=wss://odin.syncpoint.io
ODIN_API_KEY=your_odin_api_key

# Weather APIs
OPEN_METEO_API=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=your_openweathermap_api_key
MET_NORWAY_API=https://api.met.no/weatherapi

# Mapbox (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Cesium (Optional)
CESIUM_ION_TOKEN=your_cesium_ion_token

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_MAPBOX_TOKEN=your_mapbox_token
