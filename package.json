{
  "name": "apex",
  "version": "0.1.0",
  "displayName": "Apex",
  "description": "Open source tactical management system utilizing ODIN, military intelligence data, and meteorological APIs",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:build": "npm run build --prefix client && npm run build --prefix server && electron-builder --win portable",
    "electron:dist": "npm run build --prefix client && npm run build --prefix server && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "chart.js": "^4.4.0",
    "mapbox-gl": "^2.15.0",
    "cesium": "^1.110.0",
    "ws": "^8.14.2",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "eslint": "^8.55.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "tactical",
    "military",
    "odin",
    "mapping",
    "weather",
    "osint",
    "open-source"
  ],
  "author": "CSTFitzy",
  "license": "AGPL-3.0",
  "build": {
    "appId": "com.apex.tactical",
    "productName": "Apex",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "server/package.json",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/apex-logo.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "Apex-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Apex-Setup-${version}.exe",
      "shortcutName": "Apex"
    }
  }
}
